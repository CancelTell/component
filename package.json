{
  "name": "component-catalog",
  "version": "0.1.0",
  "private": true,
  "description": "COMPONENT — справочник компьютерных комплектующих: характеристики, сравнение и проверка совместимости",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "data:catalog": "tsx scripts/pipeline/catalog.ts",
    "data:prices": "tsx scripts/pipeline/prices.ts",
    "data:test": "tsx scripts/pipeline/catalog.ts --fixtures && tsx scripts/pipeline/prices.ts --fixtures",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "next": "^15.5.27",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.27",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
